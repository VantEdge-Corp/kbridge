{
  "name": "peaches",
  "private": true,
  "version": "1.0.0",
  "description": "Peaches: a verified social discovery and dating platform for Metro Atlanta. Web app, Expo mobile app, and a shared core on one Supabase project.",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:mobile": "npm run start --workspace apps/mobile --",
    "build": "npm run build --workspace apps/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace packages/core",
    "seed:generate": "esbuild scripts/generate-seed.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/peaches/generate-seed.mjs && node node_modules/.cache/peaches/generate-seed.mjs",
    "check:parity": "esbuild scripts/check-sql-parity.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/peaches/check-sql-parity.mjs && node node_modules/.cache/peaches/check-sql-parity.mjs",
    "db:test": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f supabase/tests/functional.sql"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^3.0.0",
    "@playwright/test": "^1.63.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "overrides": {
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-is": "^19.1.0"
  }
}
